#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define ENGLISH 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mt { flavor = "balanced"; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        nspc: nspc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LEFT_GUI &kp RIGHT>;
            label = "NSPC";
        };

        pspc: pspc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LEFT_GUI &kp LEFT>;
            label = "PSPC";
        };

        swap_tab: swap_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp TAB>;
            label = "SWAP_TAB";
        };

        swap_mac: swap_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp TAB>;
            label = "SWAP_MAC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "english";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | LBKT  |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | RBKT  |
            //               | CTRL| ALT  | GUI  | LOWER|  ENTER |  | SPACE | RAISE|   ,   |   .   |   ?  |

            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp N4        &kp N5                             &kp N6           &kp N7         &kp N8     &kp N9   &kp N0    &none
&none  &kp Q   &kp W   &kp E   &kp R         &kp T      &kp Y                                    &kp U          &kp I      &kp O    &kp P     &kp LBKT
&none  &kp A   &kp S   &kp D   &kp F         &kp G      &kp H                                    &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&none  &kp Z   &kp X   &kp C   &kp V         &kp B      &kp C_MUTE  &kp C_PLAY  &kp N            &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp RBKT
               &none   &none   &kp CAPSLOCK  &kp SPACE  &sl 1       &sl 2       &kp RIGHT_SHIFT  &kp RIGHT_ALT  &none      &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        lower_layer {
            display-name = "lower";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1  &kp F2            &kp F3             &kp F4            &kp F5                   &kp F6                          &kp F7   &kp F8    &kp F9         &kp F10        &kp F11     &kp F12
&trans  &swap_tab         &none              &swap_mac         &none                    &kp ESCAPE  &kp ESCAPE                   &kp HOME  &kp END        &kp BACKSPACE  &kp DELETE  &none
&trans  &sk LEFT_GUI      &sk LEFT_ALT       &sk LEFT_CONTROL  &sk LEFT_SHIFT           &kp RET     &kp ENTER                    &kp LEFT  &kp DOWN       &kp UP         &kp RIGHT   &none
&trans  &kp LG(LC(LEFT))  &kp LG(LC(RIGHT))  &tog 5            &kp LS(LG(KP_NUMBER_4))  &kp TAB     &trans      &trans  &kp TAB  &none     &kp PAGE_DOWN  &kp PAGE_UP    &kp KP_NUM  &none
                          &none              &none             &sl 4                    &trans      &trans      &trans  &trans   &trans    &none          &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &none            &none          &none          &none              &none                           &none         &none            &none              &none                 &none                  &none
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH       &kp DOLLAR         &kp PERCENT  &kp CARET                        &kp QUESTION     &kp KP_MULTIPLY    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&trans  &kp TILDE        &kp GRAVE      &kp SQT        &kp DOUBLE_QUOTES  &kp MINUS    &kp PLUS                         &sk RIGHT_SHIFT  &sk RIGHT_CONTROL  &sk RIGHT_ALT         &sk RIGHT_GUI          &none
&trans  &kp BACKSLASH    &kp AMPERSAND  &kp SEMICOLON  &kp COMMA          &kp UNDER    &trans     &trans  &kp KP_EQUAL  &kp KP_DOT       &kp COLON          &kp PIPE              &kp SLASH              &none
                         &none          &none          &trans             &trans       &trans     &trans  &trans        &trans           &none              &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2      &bt BT_SEL 3     &bt BT_SEL 4                             &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD    &rgb_ug RGB_SAI  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI
&ext_power EP_TOG  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6                          &kp KP_NUMBER_7  &kp KP_NUMBER_8    &kp KP_NUMBER_9  &kp KP_NUMBER_0  &rgb_ug RGB_EFF
&none              &sk LEFT_GUI     &sk LEFT_ALT     &sk LEFT_CONTROL  &sk LEFT_SHIFT   &kp F11          &kp F12                                  &sk RIGHT_SHIFT  &sk RIGHT_CONTROL  &sk RIGHT_ALT    &sk RIGHT_GUI    &none
&none              &kp F1           &kp F2           &kp F3            &kp F4           &kp F5           &rgb_ug RGB_TOG  &none  &kp F6           &kp F7           &kp F8             &kp F9           &kp F10          &none
                                    &none            &none             &none            &none            &none            &none  &none            &none            &none              &none
            >;
        };

        cmd {
            bindings = <
&none  &none              &none              &none              &none              &none                                                &none              &none              &none                  &none                &none                 &none
&none  &kp LS(LC(LA(Q)))  &kp LC(LA(LS(W)))  &kp LC(LA(LS(E)))  &kp LC(LA(LS(R)))  &kp LC(LA(LS(T)))  &kp RS(RA(RC(Y)))                                    &kp C_VOLUME_DOWN  &kp K_MUTE             &kp C_VOLUME_UP      &kp RS(RA(RC(P)))     &none
&none  &kp LC(LA(LS(A)))  &kp LC(LA(LS(S)))  &kp LC(LA(LS(D)))  &kp LC(LA(LS(F)))  &kp LC(LA(LS(G)))  &kp RS(RA(RC(H)))                                    &kp C_PREVIOUS     &kp C_PLAY_PAUSE       &kp C_NEXT           &kp RS(RA(RC(SEMI)))  &none
&none  &kp LC(LA(LS(Z)))  &kp LC(LA(LS(X)))  &kp LC(LA(LS(C)))  &kp LC(LA(LS(V)))  &kp LC(LA(LS(B)))  &none              &none          &kp RS(RA(RC(N)))  &kp RS(RA(RC(M)))  &kp RS(RA(RC(COMMA)))  &kp RS(RA(RC(DOT)))  &kp RS(RA(RC(FSLH)))  &none
                          &none              &none              &none              &none              &none              &kp RIGHT_GUI  &none              &none              &none                  &none
            >;
        };

        game {
            bindings = <
&none  &none      &none  &none  &none         &none                     &none      &none            &none     &none      &none      &none
&none  &kp TAB    &kp Q  &kp W  &kp E         &kp R      &none                     &none            &kp UP    &none      &kp TAB    &none
&none  &kp LSHFT  &kp A  &kp S  &kp D         &kp F      &none                     &kp LEFT         &kp DOWN  &kp RIGHT  &kp RSHFT  &none
&none  &kp LCTRL  &kp Z  &kp X  &kp C         &kp V      &none  &none   &none      &none            &none     &none      &kp RCTRL  &none
                  &none  &none  &kp LEFT_ALT  &kp SPACE  &mo 6  &tog 0  &kp SPACE  &kp PRINTSCREEN  &none     &none
            >;
        };

        game_func {
            bindings = <
&none  &none   &none   &none   &none    &none                    &none   &none   &none  &none  &none  &none
&none  &kp N5  &kp N1  &kp N2  &kp N3   &kp N4   &none                   &none   &none  &none  &none  &none
&none  &kp N0  &kp N6  &kp N7  &kp N8   &kp N9   &none                   &none   &none  &none  &none  &none
&none  &kp G   &kp F   &kp I   &kp M    &kp T    &none   &none   &none   &none   &none  &none  &none  &none
               &none   &none   &kp ESC  &kp RET  &trans  &trans  &trans  &trans  &none  &none
            >;
        };
    };
};
