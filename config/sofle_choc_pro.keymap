#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ENGLISH 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mt { flavor = "balanced"; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 1>;
            then-layer = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "english";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | LBKT  |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | RBKT  |
            //               | CTRL| ALT  | GUI  | LOWER|  ENTER |  | SPACE | RAISE|   ,   |   .   |   ?  |

            bindings = <
&none  &none        &none           &none           &none             &none                              &none          &none              &none            &none            &none           &none
&none  &kp Q        &kp W           &kp E           &kp R             &kp T      &kp Y                                  &kp U              &kp I            &kp O            &kp P           &kp LBKT
&none  &mt LCTRL A  &mt LEFT_ALT S  &mt LEFT_GUI D  &mt LEFT_SHIFT F  &kp G      &kp H                                  &mt RIGHT_SHIFT J  &mt RIGHT_GUI K  &mt RIGHT_ALT L  &mt RCTRL SEMI  &kp SQT
&none  &kp Z        &kp X           &kp C           &kp V             &kp B      &kp C_MUTE  &kp C_PLAY  &kp N          &kp M              &kp COMMA        &kp DOT          &kp FSLH        &kp RBKT
                    &none           &none           &kp ESCAPE        &kp SPACE  &kp TAB     &kp ENTER   &kp BACKSPACE  &kp DELETE         &none            &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        nav {
            bindings = <
&none  &none         &none         &none      &none           &none                        &none       &none        &none          &none         &none       &none
&none  &none         &none         &none      &none           &none  &kp K_REDO                        &kp K_PASTE  &kp K_COPY     &kp K_CUT     &kp K_UNDO  &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none  &kp CAPSLOCK                      &kp LEFT     &kp DOWN       &kp UP_ARROW  &kp RIGHT   &none
&none  &none         &none         &none      &none           &none  &none         &none   &kp INSERT  &kp HOME     &kp PAGE_DOWN  &kp PAGE_UP   &kp END     &none
                     &none         &none      &none           &none  &none         &trans  &trans      &trans       &none          &none
            >;
        };

        mouse {
            bindings = <
&none  &none         &none         &none             &none           &none                         &none      &none           &none           &none         &none            &none
&none  &none         &none         &none             &none           &none  &kp K_REDO                        &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO       &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &none                             &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none  &none         &none         &none             &none           &none  &none       &none      &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                     &none         &none             &none           &none  &none       &mkp RCLK  &mkp LCLK  &mkp MCLK       &none           &none
            >;
        };

        button {
            bindings = <
&none  &none         &none         &none             &none           &none                              &none       &none            &none              &none          &none          &none
&none  &kp K_UNDO    &kp K_CUT     &kp K_COPY        &kp K_PASTE     &kp K_REDO  &kp K_REDO                         &kp K_PASTE      &kp K_COPY         &kp K_CUT      &kp K_UNDO     &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none       &none                              &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI  &none
&none  &kp K_UNDO    &kp K_CUT     &kp K_COPY        &kp K_PASTE     &kp K_REDO  &none       &none      &kp K_REDO  &kp K_PASTE      &kp K_COPY         &kp K_CUT      &kp K_UNDO     &none
                     &none         &none             &mkp MCLK       &mkp LCLK   &mkp RCLK   &mkp RCLK  &mkp LCLK   &mkp MCLK        &none              &none
            >;
        };

        media {
            bindings = <
&none  &none         &none         &none             &none           &none                               &none             &none         &none              &none            &none         &none
&none  &none         &none         &none             &none           &none  &rgb_ug RGB_TOG                                &none         &none              &none            &none         &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &none                                          &kp K_PREV    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_NEXT    &none
&none  &none         &none         &none             &none           &none  &none            &none       &none             &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &none
                     &none         &none             &none           &none  &none            &kp K_STOP  &kp K_PLAY_PAUSE  &kp K_MUTE    &none              &none
            >;
        };
    };
};
