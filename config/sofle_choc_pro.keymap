#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define ENGLISH 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mt { flavor = "balanced"; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 1>;
            then-layer = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "english";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | LBKT  |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | RBKT  |
            //               | CTRL| ALT  | GUI  | LOWER|  ENTER |  | SPACE | RAISE|   ,   |   .   |   ?  |

            bindings = <
&none  &none        &none           &none           &none             &none                              &none          &none              &none            &none            &none           &none
&none  &kp Q        &kp W           &kp E           &kp R             &kp T      &kp Y                                  &kp U              &kp I            &kp O            &kp P           &kp LBKT
&none  &mt LCTRL A  &mt LEFT_ALT S  &mt LEFT_GUI D  &mt LEFT_SHIFT F  &kp G      &kp H                                  &mt RIGHT_SHIFT J  &mt RIGHT_GUI K  &mt RIGHT_ALT L  &mt RCTRL SEMI  &kp SQT
&none  &kp Z        &kp X           &kp C           &kp V             &kp B      &kp C_MUTE  &kp C_PLAY  &kp N          &kp M              &kp COMMA        &kp DOT          &kp FSLH        &kp RBKT
                    &none           &none           &kp ESCAPE        &kp SPACE  &kp TAB     &kp ENTER   &kp BACKSPACE  &kp DELETE         &none            &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };
    };
};
